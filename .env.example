# Copy to .env.local and fill in. Never commit .env.local.

# Backend API base URL. The browser calls it directly, so the backend must allow this app's
# origin (http://localhost:4000) in CORS with credentials, and send the refresh cookie as SameSite=None; Secure.
NEXT_PUBLIC_API_URL=https://task-forge-server-theta.vercel.app/api/v1

# Socket.io server for live updates. Leave empty to turn live updates off.
# Example: NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=
