# Copy to .env.local and fill in. Never commit .env.local.

# API base used by the browser (calls go straight to the backend).
# The backend must allow this app's origin (http://localhost:4000) in CORS with credentials,
# and send the refresh cookie as SameSite=None; Secure so /auth/refresh works cross-site.
NEXT_PUBLIC_API_URL=https://task-forge-server-theta.vercel.app/api/v1

# Alternative while the backend CORS / cookie is not ready: send calls through this app's own proxy.
# NEXT_PUBLIC_API_URL=/api/v1
# BACKEND_URL=https://task-forge-server-theta.vercel.app

# Private base URL for server-side requests (defaults to NEXT_PUBLIC_API_URL).
API_URL=

# Socket.io server for live updates. Leave empty to turn live updates off.
# Example: NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=
