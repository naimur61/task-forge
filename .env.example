# Copy to .env.local and fill in. Never commit .env.local.

# Base URL of your backend API (visible in the browser).
# Demo mode (no backend needed): NEXT_PUBLIC_API_URL=/api/mock
# Real backend:                  NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=/api/mock

# Private base URL for server-side requests (defaults to NEXT_PUBLIC_API_URL).
API_URL=

# Socket.io server.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
