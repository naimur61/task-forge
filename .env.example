# Copy to .env.local and fill in. Never commit .env.local.

# API base used by the browser. Keep it as /api/v1: Next proxies it to BACKEND_URL.
NEXT_PUBLIC_API_URL=/api/v1

# Real backend that /api/v1 is proxied to.
BACKEND_URL=https://task-forge-server-theta.vercel.app

# Private base URL for server-side requests (defaults to NEXT_PUBLIC_API_URL).
API_URL=

# Socket.io server for live updates. Leave empty to turn live updates off.
# Example: NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=
